spec opportunity_pipeline@v1
  parent none

knowledge:
  scored_source @ "fs://examples/ir/postings.jsonl"

deny: action.execute

type posting = { title: text, pay: text, employer: text, url: text }
type scored = { title: text, pay: text, employer: text, url: text, score: number, excluded: bool }

op extract_scored(source) -> scored effect external cap model.complete using prompt "job_fit_v1"
op write_output(raw) -> receipt effect recorded cap fs.write

plan main:
  raw = extract_scored(scored_source)
  out = write_output(raw)
